# Copy this file to .env.production on the DigitalOcean server.
# Do not commit the real .env.production file.

# Database
DB_NAME=dreamscope
DB_USERNAME=dreamscope_app
DB_PASSWORD=replace_with_a_long_random_password
DB_ROOT_PASSWORD=replace_with_a_different_long_random_root_password

# Spring
SPRING_PROFILES_ACTIVE=mysql
SERVER_PORT=8080

# Use "update" only for the first MVP deploy if the schema must be created from entities.
# After the first successful deploy, prefer "validate" and move future schema changes to migrations.
JPA_DDL_AUTO=validate

# Public URL
FRONTEND_URL=https://your-domain.example

# AI
OPENAI_API_KEY=replace_with_openai_api_key
OPENAI_MODEL=gpt-4o-mini

# Resend Mail
RESEND_API_KEY=replace_with_resend_api_key
RESEND_FROM=no-reply@your-domain.example

# Encryption
# Generate with: openssl rand -base64 32
DREAMSCOPE_ENCRYPTION_KEY=replace_with_base64_32_byte_key
