# Database
DB_NAME=dreamscope
DB_USERNAME=dreamscope
DB_PASSWORD=dreamscope
DB_PORT=3306
DB_URL=jdbc:mysql://localhost:3306/dreamscope?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# Spring profile: h2 or mysql
SPRING_PROFILES_ACTIVE=mysql

# AI
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini

# Resend Mail
RESEND_API_KEY=your_resend_api_key
RESEND_FROM=onboarding@resend.dev

# Encryption
# Development key only. Generate a production key with: openssl rand -base64 32
DREAMSCOPE_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# Server
SERVER_PORT=8080
FRONTEND_URL=http://localhost
